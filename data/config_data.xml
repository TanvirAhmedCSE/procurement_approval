    <record id="param_price_tolerance" model="ir.config_parameter">
        <field name="key">procurement_approval.price_tolerance</field>
        <field name="value">0</field>
    </record>
    <record id="param_qty_tolerance" model="ir.config_parameter">
        <field name="key">procurement_approval.qty_tolerance</field>
