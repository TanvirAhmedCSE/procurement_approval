<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_vendor_rating" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.vendor.rating</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="purchase_id" invisible="1"/>
                <field name="quality_rating"
                       invisible="picking_type_code != 'incoming' or not purchase_id"
                       readonly="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
