<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procurement_approval_rule_list" model="ir.ui.view">
        <field name="name">procurement.approval.rule.list</field>
        <field name="model">procurement.approval.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="min_amount"/>
                <field name="approver_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_procurement_approval_rule_form" model="ir.ui.view">
        <field name="name">procurement.approval.rule.form</field>
        <field name="model">procurement.approval.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="min_amount"/>
                            <field name="approver_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        An order needs approval from every level whose amount is at or below the order total,
                        starting from the lowest level.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_procurement_approval_rule" model="ir.actions.act_window">
        <field name="name">Approval Levels</field>
        <field name="res_model">procurement.approval.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_pending_approval_orders" model="ir.actions.act_window">
        <field name="name">Pending Approvals</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approval_state', '=', 'pending')]</field>
    </record>
</odoo>
